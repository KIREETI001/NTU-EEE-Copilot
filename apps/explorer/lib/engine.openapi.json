    "/specialization/plan": {
      "post": {
        "summary": "Specialization Plan",
        "description": "Eligibility drill-down for ALL specializations.\n\nPer spec, returns recognition + the planning view: which completed courses\ncount, what's still needed, and which counting courses are FGO-locked (FGO\nforfeits a spec's contribution \u2014 surface the irreversibility disclaimer in\nthe UI and verify with the Office of Academic Services).",
        "operationId": "specialization_plan_specialization_plan_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TranscriptRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "$ref": "#/components/schemas/SpecializationPlan"
                  },
                  "type": "object",
                  "title": "Response Specialization Plan Specialization Plan Post"
