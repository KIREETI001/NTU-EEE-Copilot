    "/parse-audit": {
      "post": {
        "summary": "Parse Audit",
        "description": "Parse an uploaded Degree Audit PDF into a reviewable DRAFT.\n\nThe PDF is processed in memory and is never stored or logged (PDPA). The\nresult is a draft for the student to review/correct \u2014 it is NOT FGO advice.",
        "operationId": "parse_audit_parse_audit_post",
        "parameters": [
          {
            "name": "university",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "ntu",
              "title": "University"
            }
          },
          {
            "name": "programme",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "eee",
              "title": "Programme"
            }
          },
          {
            "name": "cohort",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "ay2025-26",
              "title": "Cohort"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_parse_audit_parse_audit_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditParseResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
