# =============================================================================
# apps/explorer environment — copy to .env.local and fill in. NEVER commit secrets.
# =============================================================================

# --- Engine (server-only — NEVER prefix with NEXT_PUBLIC_; that would leak it) ---
# Where the Next BFF proxy (/api/optimizer/*) reaches the private FastAPI engine,
# server-to-server. Local dev: run the engine and point here.
#   cd services/engine && .venv/Scripts/python -m uvicorn app.main:app --port 8000
ENGINE_URL=http://127.0.0.1:8000

# Optional. If the engine host is public-but-secret-gated (e.g. engine on Fly/
# Render reachable from Vercel's serverless functions), the proxy sends this as
# the `x-internal-secret` header. Leave UNSET for a truly private/loopback engine.
# (The engine-side check of this header is a deploy-time TODO — see WS5 §10.)
# ENGINE_SHARED_SECRET=

# --- Supabase Auth (gates /optimizer, /eligibility, /api/optimizer/*) ---
# From your Supabase project: Settings -> API. The anon key is safe in the client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Auth enforcement:
#   unset   -> enforced in production only (local dev stays open: direct flow)
#   "true"  -> always enforce (use to exercise the gate locally)
#   "false" -> never enforce (DO NOT use in production)
# OPTIMIZER_REQUIRE_AUTH=

# --- Deprecated — DELETE this if it exists anywhere ---
# NEXT_PUBLIC_ENGINE_URL  was the old direct-call origin; it leaked the engine to
# the browser bundle and is replaced by the server-only ENGINE_URL + the proxy.
