{
  "name": "ntu-copilot",
  "private": true,
  "version": "0.1.0",
  "description": "NTU Academic & Career Co-Pilot — monorepo (rulebook + engine + explorer)",
  "workspaces": ["apps/*"],
  "scripts": {
    "rulebook:build": "node scripts/build-rulebook.mjs",
    "rulebook:validate": "node scripts/validate-rulebook.mjs",
    "rulebook:audit": "node scripts/audit.mjs",
    "audit:test": "node --test \"scripts/audit/*.test.mjs\"",
    "explorer:dev": "npm --workspace apps/explorer run dev",
    "explorer:build": "npm run rulebook:build && npm --workspace apps/explorer run build",
    "engine:test": "cd services/engine && python -m pytest",
    "engine:dev": "cd services/engine && uvicorn app.main:app --reload --port 8000"
  },
  "devDependencies": {
    "yaml": "^2.6.1"
  }
}
